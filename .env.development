# Môi trường
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=dev
DB_PASS=dev
DB_NAME=courses

# JWT
JWT_SECRET=supersecret
JWT_EXPIRES=1d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBIT_URL=amqp://localhost:5672
RABBIT_EXCHANGE=enroll.exchange
RABBIT_QUEUE=enroll.queue
RABBIT_ROUTING_KEY=enroll.key
